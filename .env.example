# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
POSTGRES_PASSWORD=vatia_dev_password_change_in_prod
DATABASE_URL=postgresql://vatia:vatia_dev_password_change_in_prod@localhost:5432/vatia

# ── pgAdmin (explorador visual de la DB) ─────────────────────────────────────
